# ML clássico de ponta a ponta: ajusta churn e serve a previsão.
experimento prever_churn:
  dados: [
    { uso: 10, plano: "a", churn: 1 },
    { uso: 9, plano: "a", churn: 1 },
    { uso: 8, plano: "b", churn: 1 },
    { uso: 7, plano: "b", churn: 1 },
    { uso: 3, plano: "a", churn: 0 },
    { uso: 2, plano: "b", churn: 0 },
    { uso: 1, plano: "a", churn: 0 },
    { uso: 0, plano: "b", churn: 0 }
  ]
  alvo: "churn"
  atributos: [uso, plano]
  pre_processar:
    - um_de_n: [plano]
    - padronizar: [uso]
  dividir: { treino: 0.75, teste: 0.25 }
  modelo: regressao_logistica
  metricas: [acuracia, f1]
  semente: 7

servico Predicao:
  porta: 8080
  rota post "/prever":
    entrada: Pedido
    passos:
      - p = experimento prever_churn.prever entrada
      - responder:
          dados:
            risco_churn: p.probabilidade
            classe: p.classe

tipo Pedido:
  uso: inteiro
  plano: texto
