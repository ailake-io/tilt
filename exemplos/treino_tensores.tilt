# Operacoes de tensor de baixo nivel (forward manual, sem autograd).

modelo Classificador:
  arquitetura: "rede_neural"
  dispositivo: gpu
  entrada: tensor[f32, 4]
  camadas:
    - linear: [4, 8]
    - ativacao: relu
    - linear: [8, 3]
    - softmax

tarefa passo_manual:
  entrada:
    lote_x: tensor[f32, 64, 4] no dispositivo gpu
    pesos: tensor[f32, 4, 3] no dispositivo gpu
  executar:
    logits = lote_x.matmul(pesos)
    probs = logits.softmax
    retornar probs.forma

pipeline demonstracao:
  passos:
    - entrada = tensor [0.1, 0.2, 0.3, 0.4]
    - probs = modelo Classificador.executar entrada
    - imprimir "forma:", probs.forma, "classe:", probs.argmax
