# stdlib_basico.tilt — importa os modulos da biblioteca padrao e exercita
# uma funcao de cada um. Roda offline: contra porta fechada, rede falha de
# forma capturavel (o roundtrip real fica no teste http_client).
importar io
importar nn
importar rede

funcao principal:
  imprimir io.juntar_caminhos("dados", "clientes.csv")
  w = tensor [[1.0, 0.0], [0.0, 1.0]]
  b = tensor [10.0, 20.0]
  x = tensor [[1.0, 2.0]]
  imprimir nn.linear(x, w, b).dados
  tentar:
    r = rede.get_json("http://127.0.0.1:1/status")
    imprimir r.status
  capturar e:
    imprimir "rede indisponivel:", e
