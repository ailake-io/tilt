# rede.tilt — cliente HTTP simples (JSON) sobre os builtins http_get_json /
# http_post_json do runtime.
#
# Coberto:
#   get_json(url, cabecalhos?)         -> valor   GET; JSON da resposta parseado
#   post_json(url, corpo, cabecalhos?) -> valor   envia corpo como JSON; parseia a resposta
#
# `cabecalhos` e um mapa { "Nome": "valor" } (texto -> texto); omitido = sem
# headers custom. Falhas de transporte, HTTP >= 400 e JSON invalido abortam
# (T901) — envolva em tentar/capturar para tratar como valor. De fora: outros
# verbos (PUT/PATCH/DELETE), corpo bruto (nao-JSON) e streaming.

funcao get_json url: texto, cabecalhos:
  retornar http_get_json url, cabecalhos

funcao post_json url: texto, corpo, cabecalhos:
  retornar http_post_json url, corpo, cabecalhos
