# rede.tilt — cliente HTTP simples.
#
# O runtime ainda nao expoe um cliente HTTP generico (o curl interno so serve
# aos conectores s3/llm/qdrant/iceberg), entao este modulo e um stub
# documentado: as funcoes existem com a assinatura planejada, nao tocam a
# rede e retornam um mapa de erro explicando o estado. Quando o builtin
# http_get/http_post entrar, as implementacoes substituem o corpo sem mudar
# a assinatura.
#
# Coberto: nada (stub). De fora: qualquer chamada HTTP real.

funcao get_json url: texto:
  retornar {ok: falso, erro: "rede.get_json: cliente HTTP ainda nao disponivel no runtime (veja guia-12-limitacoes)"}

funcao post_json url: texto, corpo:
  retornar {ok: falso, erro: "rede.post_json: cliente HTTP ainda nao disponivel no runtime (veja guia-12-limitacoes)"}
