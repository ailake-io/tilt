experimento prever_churn:
  dados: [
    { uso: 10, plano: "a", churn: 1 },
    { uso: 9, plano: "b", churn: 1 },
    { uso: 2, plano: "a", churn: 0 },
    { uso: 1, plano: "b", churn: 0 }
  ]
  alvo: "churn"
  atributos: [uso, plano]
  pre_processar:
    - um_de_n: [plano]
    - padronizar: [uso]
  dividir: { treino: 0.75, teste: 0.25 }
  modelo: regressao_logistica
  metricas: [acuracia, f1]
  semente: 7
