# RAG sobre Chroma real provisionado pelo job vector_connectors.
indice kb:
  embeddings: "m"
  armazenamento: "chroma://127.0.0.1:8000/docs"

pipeline rag:
  passos:
    - n = kb.inserir([
        { id: "a1", texto: "gato domestico" },
        { id: "b1", texto: "gato e cachorro" },
        { id: "c1", texto: "engenharia de dados" },
      ])
    - imprimir "inseridos:", n
    - achados = kb.buscar("gato", top_k: 2)
    - imprimir "texto1:", achados[0].texto
    - para cada h em achados:
        imprimir "achado:", h.id, h.score
    - unico = kb.buscar("gato", top_k: 1)
    - imprimir "top1:", unico[0].id
