pipeline principal:
  passos:
    - t1 = [
        { nome: "ana", idade: 30, nota: 9.5 },
        { nome: "bruno", idade: 40, nota: 7.0 }
      ]
    - t2 = [
        { nome: "carla", idade: 50, nota: 8.0 }
      ]
    - escrever_iceberg t1, "tabela_iceberg"
    - anexar_iceberg t2, "tabela_iceberg"
    - vendas = [
        { estado: "sp", cidade: "santos", valor: 10 },
        { estado: "sp", cidade: "campinas", valor: 30 },
        { estado: "rj", cidade: "niteroi", valor: 20 }
      ]
    - escrever_iceberg vendas, "vendas_part", particionar_por: "estado"
    - imprimir "catalogo pronto"
