pipeline nulos:
  passos:
    - dados = [
        { nome: "ana", idade: 30, salario: 3500.75, ativo: verdadeiro },
        { nome: nulo, idade: nulo, salario: 5100.50, ativo: falso },
        { nome: "carla", idade: 25, salario: nulo, ativo: verdadeiro },
        { nome: nulo, idade: 41, salario: 2890.00, ativo: nulo }
      ]
    - escrever_parquet dados, "saida_nulos.parquet"
    - volta = ler_parquet "saida_nulos.parquet"
    - para cada linha em volta:
        - imprimir linha.nome, linha.idade, linha.salario, linha.ativo
    - imprimir "linhas:", tamanho volta
