modelo M:
  entrada: tensor[f32, 2]
  camadas:
    - linear: [2, 4]
    - ativacao: relu
    - linear: [4, 2]
    - softmax

treino M:
  dados: carregador "d.csv", alvo: "y"
  perda: entropia_cruzada
  otimizador: adam
  taxa: 0.05
  epocas: 30

pipeline usar:
  passos:
    - modelo M.salvar_pesos "saida.json"
    - a = modelo M.executar tensor([0.0, 0.0])
    - imprimir "a:", a.argmax
