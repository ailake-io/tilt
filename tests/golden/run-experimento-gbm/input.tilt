experimento gbm:
  dados: [
    { x: 0, y: 0 },
    { x: 1, y: 0 },
    { x: 2, y: 0 },
    { x: 3, y: 0 },
    { x: 6, y: 1 },
    { x: 7, y: 1 },
    { x: 8, y: 1 },
    { x: 9, y: 1 }
  ]
  alvo: "y"
  atributos: [x]
  modelo: gradiente_impulsionado
  metricas: [acuracia]
  semente: 7

pipeline p:
  passos:
    - r = experimento gbm.prever { x: 7 }
    - imprimir r.classe, r.probabilidade
