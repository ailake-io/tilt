funcao tentar_anexar t -> texto:
  tentar:
    anexar_delta t, "saida_delta"
    retornar "sem erro"
  capturar erro:
    retornar erro

pipeline principal:
  passos:
    - t1 = [
        { nome: "ana", idade: 30 },
        { nome: "bruno", idade: 40 }
      ]
    - t2 = [
        { nome: "carla", idade: 50 }
      ]
    - escrever_delta t1, "saida_delta"
    - anexar_delta t2, "saida_delta"
    - tabela = ler_delta "saida_delta"
    - imprimir tamanho tabela
    - imprimir tabela[0].nome, tabela[1].idade, tabela[2].nome
    # ordem livre, mesmo schema -> append normal (fase 27: resolucao por nome)
    - reordenada = [
        { idade: 55, nome: "caio" }
      ]
    - anexar_delta reordenada, "saida_delta"
    # remocao de coluna -> erro claro (fase 27: so adicao de colunas)
    - t3 = [
        { nome: "duda", cidade: "sp" }
      ]
    - imprimir tentar_anexar t3
    # tipo divergente em coluna existente -> erro claro
    - t4 = [
        { nome: "edu", idade: "quarenta" }
      ]
    - imprimir tentar_anexar t4
    - imprimir tamanho ler_delta "saida_delta"
