funcao const42:
  retornar 42

funcao saudacao -> texto:
  retornar "ola"

funcao dobra x:
  retornar x

pipeline principal:
  passos:
    - a = const42() + 1
    - b = saudacao()
    - c = dobra 21
    - l = [10, 20]
    - m = min l
    - n = max l
    - s = somar l
    - f = l[0..2]
    - g = l[0] + 10
