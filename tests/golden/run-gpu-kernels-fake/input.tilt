modelo C:
  dispositivo: gpu
  entrada: tensor[f32, 1, 3, 3]
  camadas:
    - conv2d: [1, 1, 2, 2]
    - ativacao: gelu
    - achatar
    - linear: [4, 2]

modelo R:
  dispositivo: gpu
  entrada: tensor[f32, 2]
  camadas:
    - residual
    - ativacao: gelu

pipeline p:
  passos:
    - x = uns [1, 1, 3, 3]
    - y = modelo C.executar x
    - z = modelo R.executar tensor([1.0, 2.0])
    - imprimir "conv:", y.forma
    - imprimir "residual:", z.forma
