ferramenta saudacao:
  descricao: "monta uma saudacao"
  entrada:
    nome: texto
  executar:
    retornar "ola " + nome

pipeline p:
  passos:
    - msg = saudacao nome: "mundo"
    - imprimir msg
    - tentar:
        saudacao(nome: 7)
    capturar e:
      imprimir "erro-tipo:", e
    - tentar:
        saudacao(nome: "mundo", extra: 1)
    capturar e:
      imprimir "erro-extra:", e
    - tentar:
        saudacao()
    capturar e:
      imprimir "erro-faltante:", e
