experimento vizinhos:
  dados: [
    { x: 0, y: 0, c: "a" },
    { x: 0, y: 1, c: "a" },
    { x: 5, y: 5, c: "b" },
    { x: 5, y: 6, c: "b" },
    { x: 1, y: 0, c: "a" },
    { x: 6, y: 5, c: "b" }
  ]
  alvo: "c"
  atributos: [x, y]
  modelo: knn
    vizinhos: 3
  metricas: [acuracia]
  semente: 1

experimento grupos:
  dados: [
    { x: 0, y: 0 },
    { x: 0, y: 1 },
    { x: 1, y: 0 },
    { x: 9, y: 9 },
    { x: 9, y: 8 },
    { x: 8, y: 9 }
  ]
  atributos: [x, y]
  modelo: kmeans
    grupos: 2
  semente: 5

pipeline usa:
  passos:
    - k = vizinhos.prever { x: 0, y: 0 }
    - imprimir "classe:", k.classe, k.probabilidade
    - g = grupos.prever { x: 9, y: 9 }
    - imprimir "grupo:", g.grupo
