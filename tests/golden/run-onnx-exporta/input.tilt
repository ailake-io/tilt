modelo M:
  entrada: tensor[f32, 2]
  camadas:
    - linear: [2, 4]
    - ativacao: relu
    - linear: [4, 2]
    - softmax

pipeline usar:
  passos:
    - modelo M.exportar_onnx "modelo.onnx"
    - a = modelo M.executar tensor([1.0, 0.5])
    - imprimir "a:", a.argmax
    - imprimir "forma:", a.forma
