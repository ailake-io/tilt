modelo M:
  camadas:
    - linear: [2, 4]
    - ativacao: relu
    - linear: [4, 2]
    - softmax

treino M:
  dados: { x: [[0, 0], [0, 1], [1, 0], [1, 1], [5, 5], [5, 6], [6, 5], [6, 6]], y: [0, 0, 0, 0, 1, 1, 1, 1] }
  perda: entropia_cruzada
  otimizador: sgd
  taxa: 0.1
  epocas: 4
  lote: 4
  semente: 7
  checkpoint: "ckpt.json"
  a_cada: 2

treino M:
  dados: { x: [[0, 0], [0, 1], [1, 0], [1, 1], [5, 5], [5, 6], [6, 5], [6, 6]], y: [0, 0, 0, 0, 1, 1, 1, 1] }
  perda: entropia_cruzada
  otimizador: sgd
  taxa: 0.1
  epocas: 6
  lote: 4
  semente: 7
  retomar: "ckpt.json"

pipeline p:
  passos:
    - a = modelo M.executar tensor([0.0, 0.0])
    - b = modelo M.executar tensor([5.0, 5.0])
    - imprimir "a:", a.argmax, "b:", b.argmax
