modelo M:
  camadas:
    - linear: [2, 4]
    - ativacao: relu
    - linear: [4, 2]
    - softmax

treino M:
  dados: { x: [[0, 0], [0, 1], [1, 0], [1, 1], [5, 5], [5, 6], [6, 5], [6, 6]], y: [0, 0, 0, 0, 1, 1, 1, 1] }
  perda: entropia_cruzada
  otimizador: adam
  taxa: 0.05
  epocas: 50
  lote: 8
  semente: 7
  validacao: 0.25
  parar_cedo: { paciencia: 3, melhorar_min: 0.01 }

pipeline p:
  passos:
    - a = modelo M.executar tensor([0.0, 0.0])
    - b = modelo M.executar tensor([5.0, 5.0])
    - imprimir "a:", a.argmax, "b:", b.argmax
