llm gpt:
  provedor: "anthropic"
  modelo: "claude-sonnet-5"
  chave: env "ANTHROPIC_API_KEY"

llm gpt2:
  provedor: "openai"
  modelo: "mock-juiz-2"

avaliacao juiz:
  dados:
    - { v: "PASSA", esperado: "x" }
  executar:
    - retornar caso.v
  metricas: [juiz]
  juiz:
    cadeia: [gpt, gpt2]
    consenso: maioria
    usuario: "Repita: {{saida}}"
  verboso: verdadeiro
