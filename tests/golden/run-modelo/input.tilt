modelo M:
  camadas:
    - linear: [3, 4]
    - ativacao: relu
    - linear: [4, 2]
    - softmax

pipeline p:
  passos:
    - x = tensor [0.5, 0.5, 0.5]
    - y = modelo M.executar x
    - imprimir "forma:", y.forma
    - imprimir "soma:", y.soma
    - lote = tensor [[1, 0, 0], [0, 1, 0]]
    - imprimir "lote:", (modelo M.executar lote).forma
    - tabela = [{ a: 1, b: 0, c: 0 }, { a: 0, b: 1, c: 0 }]
    - previsoes = modelo M.prever_lote(tabela, colunas: ["a", "b", "c"])
    - imprimir "previsoes:", previsoes.tamanho
    - imprimir "primeira soma:", previsoes[0].saida[0] + previsoes[0].saida[1]
    - lote_saida = modelo M.executar lote
    - imprimir "mesma ordem:", previsoes[0].saida[0] == lote_saida[0, 0], previsoes[1].saida[0] == lote_saida[1, 0]
